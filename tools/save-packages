#!/bin/bash
# Record which packages this machine has beyond a stock Omarchy install.
#
#   tools/save-packages           rewrite tools/packages.txt
#   tools/save-packages --check   show what changed, write nothing (exit 1 if drift)
#
# The list is what `setup.sh` installs on a new machine. It is generated, but
# safe to hand-edit: anything you add is kept, since the file is regenerated
# from the union of the computed delta and whatever is already committed.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$REPO/tools/packages.txt"
OMARCHY_INSTALL=${OMARCHY_PATH:-/usr/share/omarchy}/install

command -v pacman >/dev/null || { echo "not an Arch system" >&2; exit 1; }

# Packages Omarchy itself installs, from its own manifests.
omarchy_manifest() {
  cat "$OMARCHY_INSTALL"/omarchy-*.packages 2>/dev/null |
    grep -vE '^\s*(#|$)' | tr -s ' ' '\n' | sed 's/#.*//' | grep -v '^$'
}

# Omarchy's manifests are written for x86_64. On Arch Linux ARM a set of base
# and hardware packages is installed by the ISO but absent from those lists, so
# the raw delta picks them up as if they were hand-installed. They are not
# choices worth recording, so drop them. Extend this list if new noise appears.
ARM_BASE='^(systemd|systemd-resolvconf|sudo|dbus|polkit|mesa|wayland|zstd|coreutils|sed|e2fsprogs|mkinitcpio|openssh|python|vulkan-swrast|xorg-xwayland|xdg-user-dirs|xdg-utils|shared-mime-info|desktop-file-utils|gvfs|libnotify)$'

# try-omarchy-* is VM provisioning; omarchy-* comes with the distro.
DISTRO='^(try-omarchy-|omarchy-|linux-aarch64|archlinuxarm-keyring)'

computed=$(
  comm -23 \
    <(pacman -Qqe | sort -u) \
    <(cat <(omarchy_manifest) <(pacman -Qgq base base-devel 2>/dev/null) | sort -u) |
    grep -vE "$DISTRO" | grep -vE "$ARM_BASE" || true
)

# Union with anything already committed, so hand-added entries survive and a
# machine missing a package does not silently drop it for every other machine.
existing=""
[[ -f $OUT ]] && existing=$(grep -vE '^\s*(#|$)' "$OUT" || true)

merged=$(printf '%s\n%s\n' "$computed" "$existing" | grep -v '^$' | sort -u)

render() {
  cat <<EOF
# Packages installed on top of a stock Omarchy system.
#
# Generated by tools/save-packages; hand-edits are preserved on regeneration.
# Read by setup.sh on Linux. Run tools/save-packages after installing something
# you want on every machine.
#
# Last updated: $(date -u +%Y-%m-%d)

EOF
  printf '%s\n' "$merged"
}

if [[ ${1:-} == --check ]]; then
  new=$(comm -13 <(printf '%s\n' "$existing" | grep -v '^$' | sort -u) <(printf '%s\n' "$merged"))
  if [[ -z $new ]]; then
    echo "packages.txt is up to date"
    exit 0
  fi
  echo "packages.txt is out of date. Installed but not recorded:"
  printf '%s\n' "$new" | sed 's/^/  + /'
  exit 1
fi

render >"$OUT"
echo "wrote $OUT ($(printf '%s\n' "$merged" | grep -c .) packages)"
