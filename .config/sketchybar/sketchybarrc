#!/usr/bin/env sh

CONFIG_DIR="$HOME/.config/sketchybar"   # items/spaces.sh resolves $CONFIG_DIR/plugins
ITEM_DIR="$CONFIG_DIR/items"            # Directory where the items are configured
PLUGIN_DIR="$CONFIG_DIR/plugins"        # Directory where all the plugin scripts are stored

source "$CONFIG_DIR/colors.sh" # Loads all defined colors
source "$CONFIG_DIR/icons.sh"  # Loads all defined icons

# "SF Pro" is a sudo .pkg install (see setup.sh). Fall back to a font we know is
# present so text stays legible before it is installed. Note that the SF Symbols
# glyphs in icons.sh only render once SF Pro is actually installed.
FONT="SF Pro" # Needs Regular, Bold, Semibold, Heavy and Black variants
if [ ! -e "/Library/Fonts/SF-Pro.ttf" ] && [ ! -e "$HOME/Library/Fonts/SF-Pro.ttf" ]; then
  FONT="Hack Nerd Font"
fi

# The mach helper (helper/) provides the CPU graphs and the clock. Built by setup.sh.
HELPER=git.felix.helper
killall helper >/dev/null 2>&1
"$CONFIG_DIR/helper/helper" "$HELPER" >/dev/null 2>&1 &

PADDINGS=3 # All paddings use this value (icon, label, background)

POPUP_BORDER_WIDTH=2
POPUP_CORNER_RADIUS=11

SHADOW=on

# Setting up the general bar appearance and default values.
# topmost=on lifts the bar to window layer 25, one above the macOS menu bar at
# 24, so the auto-hidden menu bar (_HIHideMenuBar) reveals *behind* the bar
# instead of over it when the pointer nudges the top edge.
# The cost of that is App/File/Window menus becoming unreachable by pointer,
# since the bar is what the click lands on. SUPER+M covers it: it drops the bar
# below the menu bar; a second press raises it again, and it restores itself
# after ten seconds if you forget (aerospace/scripts/reveal-menubar.sh).
# Drop-down menus are in a far higher window layer, so once a menu is open it
# draws over the bar regardless.
# The bar's own drop shadow reads as a blurred smear along the top edge of the
# windows beneath it - hence shadow=off. Popups keep their shadow via $SHADOW.
sketchybar --bar     height=35                                         \
                     color=$BAR_COLOR                                  \
                     shadow=off                                       \
                     position=top                                      \
                     topmost=on                                        \
                     sticky=on                                         \
                     padding_right=10                                  \
                     padding_left=10                                   \
                     corner_radius=0                                   \
                     y_offset=0                                        \
                     margin=0                                          \
                     blur_radius=20                                    \
                                                                       \
           --default updates=when_shown                                \
                     icon.font="$FONT:Bold:14.0"                       \
                     icon.color=$ICON_COLOR                            \
                     icon.padding_left=$PADDINGS                       \
                     icon.padding_right=$PADDINGS                      \
                     label.font="$FONT:Semibold:13.0"                  \
                     label.color=$LABEL_COLOR                          \
                     label.padding_left=$PADDINGS                      \
                     label.padding_right=$PADDINGS                     \
                     background.padding_right=$PADDINGS                \
                     background.padding_left=$PADDINGS                 \
                     popup.background.border_width=$POPUP_BORDER_WIDTH \
                     popup.background.corner_radius=$POPUP_CORNER_RADIUS \
                     popup.background.border_color=$POPUP_BORDER_COLOR \
                     popup.background.color=$POPUP_BACKGROUND_COLOR    \
                     popup.background.shadow.drawing=$SHADOW

# Left
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/layout.sh"
source "$ITEM_DIR/front_app.sh"

# Right. Items added to "right" stack right-to-left, so the first one sourced is
# the rightmost. Grouped by what each one answers, reading left to right:
#
#   cpu  claude  |  volume  caffeine  battery  |  vpn  clock
#   what am I       what I control, and         where am I,
#   burning         what it costs in power      and when
#
# The middle three are bracketed into one pill at the bottom of this file; the
# meters and the clock stay free-standing so the row has three beats, not seven.
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/vpn.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/caffeine.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/claude.sh"
source "$ITEM_DIR/cpu.sh"

############## GROUPING ##############
# One raised pill behind the three small status glyphs. Brackets have to come
# after the items they group, so this lives here rather than beside them.
sketchybar --add bracket status volume caffeine battery       \
           --set status background.color=$BACKGROUND_1        \
                        background.corner_radius=9            \
                        background.height=24                  \
                        background.drawing=on

############## FINALIZING THE SETUP ##############
sketchybar --update

echo "sketchybar configuration loaded.."
