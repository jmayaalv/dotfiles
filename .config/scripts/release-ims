#!/bin/sh
# Fast-forward a Beluca release branch to its source branch.
#
#   release-ims qa       develop -> release/qa
#   release-ims master   master  -> release/master
#
# Updating a release branch is what deploys: a Bitbucket branch pipeline fires
# on release/* and triggers the GitLab pipeline that does the deploy. The
# custom: release/qa and release/master pipelines in bitbucket-pipelines.yml
# look like the release path but are dormant.
#
# The promotion goes through a pull request rather than a direct push, because
# release/qa and release/master are restricted branches and a plain push is
# refused with "Permission denied to update branch release/qa". The PR is merged
# with Bitbucket's fast_forward strategy, so the result is identical to the push
# that is not permitted: no merge commit, and the release branch lands exactly on
# the source commit.
#
# By default this works in its own bare repository under ~/.cache rather than a
# checkout, so it cannot be affected by, or affect, whatever state a working
# clone happens to be in. Set IMS_REPO to point it at a real clone instead.

set -eu

WORKSPACE="belucasys"
REPO_SLUG="beluca"
REMOTE_URL="git@bitbucket.org:$WORKSPACE/$REPO_SLUG.git"
API="https://api.bitbucket.org/2.0/repositories/$WORKSPACE/$REPO_SLUG"
CACHE_REPO="${XDG_CACHE_HOME:-$HOME/.cache}/release-ims/$REPO_SLUG.git"
PIPELINES_URL="https://bitbucket.org/$WORKSPACE/$REPO_SLUG/pipelines"
KEYCHAIN_SERVICE="release-ims"

PROG=$(basename "$0")

usage() {
    cat <<USAGE
usage: $PROG <target> [-n|--dry-run] [-y|--yes]

targets:
  qa       develop -> release/qa
  master   master  -> release/master

options:
  -n, --dry-run  do everything except opening and merging the pull request
  -y, --yes      skip the confirmation prompt (not accepted for master)
  -h, --help     show this message

environment:
  IMS_REPO        use this git repository instead of the private one under
                  \$XDG_CACHE_HOME/release-ims
  BITBUCKET_USER  Bitbucket account for the API call; defaults to the account
                  stored on the keychain item

credentials:
  A Bitbucket API token is read from the login keychain, service
  "$KEYCHAIN_SERVICE". Store one with:

    security add-generic-password -s $KEYCHAIN_SERVICE -a <your-atlassian-email> -w
USAGE
}

die() {
    echo "$PROG: $*" >&2
    exit 1
}

TARGET=""
DRY_RUN=no
ASSUME_YES=no

while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY_RUN=yes ;;
        -y|--yes)     ASSUME_YES=yes ;;
        -h|--help)    usage; exit 0 ;;
        -*)           usage >&2; die "unknown option: $1" ;;
        *)
            [ -z "$TARGET" ] || { usage >&2; die "unexpected argument: $1"; }
            TARGET="$1"
            ;;
    esac
    shift
done

[ -n "$TARGET" ] || { usage >&2; exit 1; }

# DEST_LABEL is the branch, not an environment name. Only the QA route is known
# from the pipeline config; what release/master ultimately deploys to is not,
# so this does not claim to know.
case "$TARGET" in
    qa)
        SRC=develop
        DST=release/qa
        DEST_LABEL="QA"
        ;;
    master)
        SRC=master
        DST=release/master
        DEST_LABEL="RELEASE/MASTER"
        ;;
    *)
        usage >&2
        die "unknown target: $TARGET"
        ;;
esac

# A confirmation that is one keystroke away from a QA promotion is not enough
# friction for the master line, so that target requires typing its name and
# refuses --yes outright.
if [ "$TARGET" = master ] && [ "$ASSUME_YES" = yes ]; then
    die "--yes is not accepted for the master target; confirm it interactively"
fi

command -v jq >/dev/null 2>&1 || die "jq is required but not installed (brew install jq)"

read_credentials() {
    BB_TOKEN=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null) || return 1
    if [ -n "${BITBUCKET_USER:-}" ]; then
        BB_USER="$BITBUCKET_USER"
    else
        BB_USER=$(security find-generic-password -s "$KEYCHAIN_SERVICE" 2>/dev/null |
            awk -F'"' '/"acct"<blob>=/{print $4}')
    fi
    [ -n "$BB_TOKEN" ] && [ -n "$BB_USER" ]
}

no_credentials() {
    cat >&2 <<MSG
$PROG: no Bitbucket API token on the keychain (service "$KEYCHAIN_SERVICE").

Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
and store it with:

  security add-generic-password -s $KEYCHAIN_SERVICE -a <your-atlassian-email> -w

The token needs write access to pull requests on $WORKSPACE/$REPO_SLUG.
MSG
    exit 1
}

# Prints the response body on success. On any non-2xx the body is printed to
# stderr with Bitbucket's own error message pulled out, because the interesting
# failures here - a merge check, a revoked token - are only explained there.
bb_api() {
    method=$1
    url=$2
    body=${3:-}
    tmp=$(mktemp)
    if [ -n "$body" ]; then
        code=$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" \
            -u "$BB_USER:$BB_TOKEN" -H 'Content-Type: application/json' \
            -d "$body" "$url")
    else
        code=$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" \
            -u "$BB_USER:$BB_TOKEN" "$url")
    fi
    case "$code" in
        2*)
            cat "$tmp"
            rm -f "$tmp"
            ;;
        *)
            echo "$PROG: Bitbucket returned HTTP $code for $method $url" >&2
            jq -r '.error.message // .error // .' "$tmp" >&2 2>/dev/null || cat "$tmp" >&2
            rm -f "$tmp"
            return 1
            ;;
    esac
}

if [ -n "${IMS_REPO:-}" ]; then
    REPO="$IMS_REPO"
    git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 ||
        die "IMS_REPO is not a git repository: $REPO"
else
    REPO="$CACHE_REPO"
    if [ ! -d "$REPO" ]; then
        echo "Creating $REPO ..."
        mkdir -p "$REPO"
        git init --quiet --bare "$REPO"
        git -C "$REPO" remote add origin "$REMOTE_URL"
    fi
fi

# Only commits are ever read, so trees and blobs are filtered out of the fetch.
# Not every server honours every filter, hence the fallbacks; an unfiltered
# fetch of this monorepo is slow but still correct.
fetch_refs() {
    spec_src="+refs/heads/$SRC:refs/remotes/origin/$SRC"
    spec_dst="+refs/heads/$DST:refs/remotes/origin/$DST"
    for filter in "--filter=tree:0" "--filter=blob:none" ""; do
        # shellcheck disable=SC2086
        if git -C "$REPO" fetch --quiet $filter origin "$spec_src" "$spec_dst" 2>/dev/null; then
            return 0
        fi
    done
    # Run once more unfiltered without swallowing stderr, so the real reason
    # for the failure reaches the user.
    git -C "$REPO" fetch origin "$spec_src" "$spec_dst"
}

echo "Fetching $SRC and $DST ..."
fetch_refs || die "fetch failed; refusing to act on stale refs"

git -C "$REPO" rev-parse --verify --quiet "refs/remotes/origin/$SRC" >/dev/null ||
    die "no such branch on origin: $SRC"
git -C "$REPO" rev-parse --verify --quiet "refs/remotes/origin/$DST" >/dev/null ||
    die "no such branch on origin: $DST"

SRC_REF="origin/$SRC"
DST_REF="origin/$DST"
SRC_SHA=$(git -C "$REPO" rev-parse --short "$SRC_REF")

AHEAD=$(git -C "$REPO" rev-list --count "$SRC_REF..$DST_REF")
BEHIND=$(git -C "$REPO" rev-list --count --first-parent "$DST_REF..$SRC_REF")

if [ "$AHEAD" -gt 0 ]; then
    echo "$DST has $AHEAD commit(s) that are not in $SRC:" >&2
    git -C "$REPO" log --oneline "$SRC_REF..$DST_REF" >&2
    echo >&2
    die "not a fast-forward; $DST has to be reconciled with $SRC first"
fi

if [ "$BEHIND" -eq 0 ]; then
    echo "$DST is already at $SRC ($SRC_SHA). Nothing to release."
    exit 0
fi

# --first-parent collapses each squashed pull request and each back-merge to a
# single line, and the count uses the same filter so the two cannot disagree.
echo
echo "$BEHIND commit(s) to promote from $SRC to $DST:"
echo
git -C "$REPO" log --oneline --first-parent --max-count=30 "$DST_REF..$SRC_REF"
if [ "$BEHIND" -gt 30 ]; then
    echo "... and $((BEHIND - 30)) more"
fi
echo

if [ "$DRY_RUN" = yes ]; then
    if read_credentials; then
        echo "Dry run: would fast-forward $DST to $SRC ($SRC_SHA) via a pull request as $BB_USER."
    else
        echo "Dry run: would fast-forward $DST to $SRC ($SRC_SHA) via a pull request."
        echo "Note: no API token on the keychain yet, so a real run would stop and explain how to add one."
    fi
    exit 0
fi

read_credentials || no_credentials

if [ "$ASSUME_YES" != yes ]; then
    if [ "$TARGET" = master ]; then
        printf 'Promote to %s? Type "master" to confirm: ' "$DEST_LABEL"
        # An EOF leaves REPLY empty, which is not a confirmation.
        read -r REPLY || REPLY=""
        [ "$REPLY" = master ] || die "aborted"
    else
        printf 'Promote to %s? [y/N] ' "$DEST_LABEL"
        read -r REPLY || REPLY=""
        case "$REPLY" in
            y|Y|yes|YES) ;;
            *) die "aborted" ;;
        esac
    fi
fi

# An open pull request for this pair may already exist, from an earlier run that
# opened one but could not merge it. Bitbucket refuses a second one, so reuse it.
#
# The state has to be part of q rather than a separate state parameter: supplying
# both makes Bitbucket ignore the parameter and return merged pull requests too,
# and reusing a merged one would fail at the merge step with a confusing error.
PR_QUERY="state=\"OPEN\" AND source.branch.name=\"$SRC\" AND destination.branch.name=\"$DST\""
PR_QUERY_ENC=$(jq -rn --arg q "$PR_QUERY" '$q|@uri')
PR_ID=$(bb_api GET "$API/pullrequests?pagelen=5&fields=values.id&q=$PR_QUERY_ENC" |
    jq -r 'first(.values[].id) // empty')

if [ -n "$PR_ID" ]; then
    echo "Reusing open pull request #$PR_ID."
else
    PR_BODY=$(jq -n --arg t "Promote $SRC to $DST ($SRC_SHA)" --arg s "$SRC" --arg d "$DST" \
        '{title: $t, source: {branch: {name: $s}}, destination: {branch: {name: $d}}, close_source_branch: false}')
    PR_ID=$(bb_api POST "$API/pullrequests" "$PR_BODY" | jq -r '.id')
    [ -n "$PR_ID" ] && [ "$PR_ID" != null ] || die "could not create the pull request"
    echo "Opened pull request #$PR_ID."
fi

MERGE_BODY='{"merge_strategy":"fast_forward","close_source_branch":false}'
MERGED_SHA=$(bb_api POST "$API/pullrequests/$PR_ID/merge" "$MERGE_BODY" |
    jq -r '.merge_commit.hash // empty') || {
    echo "$PROG: pull request #$PR_ID is open but was not merged." >&2
    echo "Review it at https://bitbucket.org/$WORKSPACE/$REPO_SLUG/pull-requests/$PR_ID" >&2
    exit 1
}

echo
echo "Merged pull request #$PR_ID: $DST is now at $(echo "$MERGED_SHA" | cut -c1-10)."
# The pipeline step that triggers the deploy curls GitLab without --fail, so a
# green Bitbucket step does not by itself prove the deploy was triggered. Check
# the run rather than assuming it.
echo "Check the pipeline: $PIPELINES_URL"
