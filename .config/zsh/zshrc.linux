export LANGUAGE=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export LANG=en_US.UTF-8

export PATH=$HOME/bin:$HOME/.local/bin:$HOME/.config/eza:$HOME/.npm-global/bin/:$PATH

# Debian/Ubuntu ship bat as batcat; Arch (Omarchy) calls it bat, as .zshrc expects.
command -v batcat >/dev/null && alias cat='batcat'

# --- Omarchy (Arch) ----------------------------------------------------------
# What Omarchy's bash startup does, for zsh. OMARCHY_PATH, the mise shims and
# EDITOR/BROWSER/MANPAGER come from ~/.zshenv (see the dotfiles README).
if [[ -r /usr/share/omarchy/default/bash/envs ]]; then
  emulate sh -c '. /usr/share/omarchy/default/bash/envs'
fi

# mise: Omarchy installs clojure, babashka, node, claude... through it.
command -v mise >/dev/null && eval "$(mise activate zsh)"

# try: throwaway project folders in ~/Work/tries, loaded on first use.
if command -v try >/dev/null; then
  try() {
    unset -f try
    eval "$(SHELL=/bin/zsh command try init ~/Work/tries)"
    try "$@"
  }
fi

# Omarchy's bash aliases (lt, ff, g, d, h, ..., n, open) and helper functions
# (tdl, ga/gd worktrees, compress, rsw/lsw, fip...), loaded from Omarchy itself so
# they follow its updates. Two exceptions keep the shared config in charge:
#  - cd: Omarchy aliases it to zd -> z, but .zshrc makes zoxide `cd` itself
#    (zoxide init --cmd cd), so there is no z; keep .zshrc's cd.
#  - ls: keep the shared plain eza.
# The ssh auto-reconnect wrapper (fns/ssh-reconnect) is left out: it relies on
# bash's `argv` and 0-based arrays, and in zsh would never reconnect.
if [[ -r ${OMARCHY_PATH:-/usr/share/omarchy}/default/bash/aliases ]]; then
  source ${OMARCHY_PATH:-/usr/share/omarchy}/default/bash/aliases
  unalias cd 2>/dev/null; unfunction zd 2>/dev/null
  alias ls='eza'
  for f in ${OMARCHY_PATH:-/usr/share/omarchy}/default/bash/fns/*(N); do
    [[ ${f:t} == ssh-reconnect ]] || source $f
  done
  unset f
fi

# `ec` comes from ~/.local/bin/ec on Linux: emacsclient -t on the systemd Emacs daemon.
