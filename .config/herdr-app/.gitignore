# Only what AGENTS.md calls config. The rest the app writes itself: state,
# bookkeeping, telemetry, frame/, icons/, typings, and data/ (mod secrets).
/*
!/.gitignore
!/keys.json
!/settings.json
!/programs.json
!/layouts/
!/themes/
!/mods/
# Herdr writes its own layouts and mods (installed.json lists them) at every
# start and update, on each machine, so only ours are kept. Add new ones here.
/layouts/*
!/layouts/my-main.json
/mods/*
!/mods/pluck
!/mods/resize
!/mods/tuicr
!/mods/walkthrough
*.d.ts
jsconfig.json
